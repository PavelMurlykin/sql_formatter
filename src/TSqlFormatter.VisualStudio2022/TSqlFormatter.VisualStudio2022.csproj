<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <GenerateVsixContainer>true</GenerateVsixContainer>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\TSqlFormatter.VisualStudio\*.cs" Link="VisualStudio\%(Filename)%(Extension)" />
    <Compile Include="..\TSqlFormatter.IdeShared\*.cs" Link="IdeShared\%(Filename)%(Extension)" />
    <ProjectCapability Include="CreateVsixContainer" />
    <PackageReference Include="Microsoft.VisualStudio.SDK" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" />
    <PackageReference Include="Newtonsoft.Json">
      <ForceIncludeInVSIX>true</ForceIncludeInVSIX>
    </PackageReference>
    <ProjectReference Include="..\TSqlFormatter.Core\TSqlFormatter.Core.csproj" />
    <ProjectReference Include="..\TSqlFormatter.Configuration\TSqlFormatter.Configuration.csproj" />
    <Reference Include="System.Design" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <VSCTCompile Include="..\TSqlFormatter.VisualStudio\Commands.vsct" Link="Commands.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>
</Project>
